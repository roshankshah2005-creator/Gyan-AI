# Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=

# Secret used to sign login session cookies (any long random string,
# e.g. generate one with: openssl rand -base64 32)
SESSION_SECRET=

# Postgres connection string. If you add a Postgres database to your
# Vercel project (Storage tab -> Marketplace -> Neon/Postgres), copy the
# connection string it gives you here (Vercel also injects this
# automatically as an env var once the integration is attached).
DATABASE_URL=
